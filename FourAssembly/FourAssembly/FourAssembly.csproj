<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="EasyModbus" Version="4.4.0" />
    <Reference Include="EasyModbus">
      <HintPath>$(NuGetPackageRoot)easymodbus\4.4.0\EasyModbus.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\StationCountersForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\StationCountersForm.Designer.cs">
      <DependentUpon>StationCountersForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\SettingsEditorForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\SettingsEditorForm.Designer.cs">
      <DependentUpon>SettingsEditorForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\StationErrorAlertForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\StationErrorAlertForm.Designer.cs">
      <DependentUpon>StationErrorAlertForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\AdminUnlockForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\AdminUnlockForm.Designer.cs">
      <DependentUpon>AdminUnlockForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
